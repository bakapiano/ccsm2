{
  "name": "ccsm2",
  "private": true,
  "version": "0.1.0-beta.9",
  "packageManager": "pnpm@10.11.0",
  "scripts": {
    "dev": "pnpm desktop:dev",
    "build": "pnpm --filter @ccsm/desktop build",
    "check": "pnpm verify:tauri-runtime && pnpm --filter @ccsm/desktop check && cargo check --workspace --locked",
    "test": "node --test .github/scripts/*.test.mjs && cargo test --workspace --locked && pnpm --filter @ccsm/desktop test",
    "format": "cargo fmt --all && pnpm --filter @ccsm/desktop format",
    "format:check": "cargo fmt --all -- --check && pnpm --filter @ccsm/desktop format:check",
    "verify:version": "node scripts/check-release-version.mjs",
    "verify:tauri-runtime": "node scripts/check-tauri-runtime-dependencies.mjs",
    "desktop:dev": "pnpm --filter @ccsm/desktop dev:desktop",
    "desktop:build:debug": "pnpm --filter @ccsm/desktop build:desktop:debug",
    "desktop:build:release": "pnpm --filter @ccsm/desktop tauri build --config src-tauri/tauri.release.conf.json -- --locked",
    "test:desktop:build": "pnpm --filter @ccsm/desktop build:desktop:e2e",
    "test:desktop": "pnpm --filter @ccsm/desktop test:desktop",
    "test:desktop:ci": "pnpm --filter @ccsm/desktop test:desktop:ci",
    "test:desktop:debug": "pnpm --filter @ccsm/desktop test:desktop:debug",
    "test:desktop:evidence": "pnpm --filter @ccsm/desktop test:desktop:evidence",
    "test:provider-cli-contract": "pnpm --filter @ccsm/desktop test:provider-cli-contract",
    "package:ubuntu": "bash scripts/package-ubuntu.sh",
    "package:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package-windows.ps1",
    "contracts": "cargo test --locked -p ccsm-core export_bindings && cargo test --locked -p ccsm-desktop export_bindings"
  }
}
