+/// Return a stable, non-zero identifier for a hyperlink URI. Ghostty's native
+/// hyperlink identifiers are page-local, while the web renderer compares cells
+/// from several pages at once. Hashing the URI gives the renderer one stable
+/// identity across viewport and scrollback pages while preserving explicit and
+/// implicit OSC 8 identities.
+fn cellHyperlinkId(page: anytype, cell: anytype) u16 {
+    const id = page.lookupHyperlink(cell) orelse return 0;
+    const link = page.hyperlink_set.get(page.memory, id);
+    const hash: u16 = @truncate(link.hash(page.memory));
+    return if (hash == 0) 1 else hash;
+}
