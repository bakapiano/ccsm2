+/// Get the OSC 8 URI for one screen or scrollback cell. Passing a null output
+/// pointer returns the required UTF-8 byte length. A positive second call copies
+/// the URI into the caller-provided buffer.
+pub fn getHyperlinkUri(
+    ptr: ?*anyopaque,
+    history: bool,
+    row: c_int,
+    col: c_int,
+    out: ?[*]u8,
+    buf_size: usize,
+) callconv(.c) c_int {
+    const wrapper: *const TerminalWrapper = @ptrCast(@alignCast(ptr orelse return -1));
+    if (row < 0 or col < 0) return -1;
+
+    const pages = &wrapper.terminal.screens.active.pages;
+    const pin = if (history)
+        pages.pin(.{ .history = .{ .y = @intCast(row) } })
+    else
+        pages.pin(.{ .active = .{ .y = @intCast(row) } });
+    const resolved = pin orelse return -1;
+    const cells = resolved.cells(.all);
+    const x: usize = @intCast(col);
+    if (x >= cells.len) return -1;
+
+    const page = resolved.node.data;
+    const cell = &cells[x];
+    const id = page.lookupHyperlink(cell) orelse return 0;
+    const link = page.hyperlink_set.get(page.memory, id);
+    const uri = link.uri.slice(page.memory);
+    if (out) |buffer| {
+        if (buf_size < uri.len) return -1;
+        @memcpy(buffer[0..uri.len], uri);
+    }
+    return @intCast(uri.len);
+}
