{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CCSM",
  "version": "0.1.0-beta.8",
  "identifier": "dev.ccsm.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:1421",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "CCSM",
        "width": 1320,
        "height": 800,
        "minWidth": 900,
        "minHeight": 560,
        "resizable": true,
        "decorations": false,
        "additionalBrowserArgs": "--remote-debugging-port=9226 --disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection",
        "dataDirectory": "ccsm-main-webview"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/bakapiano/ccsm2/releases/download/updater-beta/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDdCMEY2OUZENTMwQUY5ODcKUldTSCtRcFQvV2tQZTVvNWlyZUVDT3BGcWdMY0tCSmlyRUVzMXBBTURBUVBFaGZGb3F1U0xQVEMK",
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "publisher": "CCSM",
    "category": "DeveloperTool",
    "shortDescription": "A desktop workspace for coding agents.",
    "licenseFile": "../../../LICENSE",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ]
  }
}
