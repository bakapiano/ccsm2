{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CCSM",
  "version": "0.1.0-beta.4",
  "identifier": "dev.ccsm.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:1421",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "CCSM",
        "width": 1320,
        "height": 800,
        "minWidth": 900,
        "minHeight": 560,
        "resizable": true,
        "decorations": false,
        "additionalBrowserArgs": "--remote-debugging-port=9226 --disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection",
        "dataDirectory": "ccsm-main-webview"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false
  }
}
